# Only needed for mode "testnet" / "live". Never commit .env.
# Your MAIN wallet address (the one holding USDC on Hyperliquid). Public address, not a key.
HL_ACCOUNT_ADDRESS=
# Private key of an API wallet created at app.hyperliquid.xyz/API. It can trade but CANNOT withdraw.
# Never put your main wallet's private key here.
HL_AGENT_PRIVATE_KEY=
# Optional: TypeSafe Jev key (typesafe.ai; signups paused as of 2026-09-22). Set jev.enabled=true in config.json.
TYPESAFE_AI_API_KEY=
# Optional: OpenRouter key (openrouter.ai/keys). Used when ai.provider = "openrouter" and ai.enabled = true.
OPENROUTER_API_KEY=
# Phone dashboard (http://localhost:8090). UI starts only if this is set. Use a long random password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
UI_PASSWORD=
